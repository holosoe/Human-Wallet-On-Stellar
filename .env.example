# Human Passport Configuration
# Get these from https://developer.passport.xyz - sign up for an API key and create a scorer
NEXT_PUBLIC_API_KEY=your_human_passport_api_key_here
NEXT_PUBLIC_SCORER_ID=your_human_passport_scorer_id_here

# WalletConnect Configuration  
# Get this from https://cloud.reown.com/sign-in - create a new project
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

